LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
MODEL_DECIDE=lfm2
MODEL_GUARD=qwen3-4b
MODEL_TEXT=qwen3-4b
MODEL_EMBED=bge-m3
DATABASE_URL=postgresql+asyncpg://sorter:sorter@localhost:5432/sorter
RABBIT_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=transcripts
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=llm-sorter
STORAGE_ROOT=./data/out
SOURCE_DIR=./data/inbox
POLL_INTERVAL_S=10
METRICS_PORT=9100
SWEEP_INTERVAL_S=600
MAX_CONCURRENT_ACTIVITIES=8
# хостовые порты RabbitMQ для docker compose (если 5672/15672 заняты); тогда поправить RABBIT_URL
# RABBIT_PORT=5673
# RABBIT_MGMT_PORT=15673
# хостовый порт Temporal UI (по умолчанию 8088, 8080 часто занят)
# TEMPORAL_UI_PORT=8088
# ingest из папок Telegram вместо SOURCE_DIR (список папок: llm-sorter tg-folders)
# INGEST_SOURCE=telegram
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION=          # Telethon StringSession
# TG_FOLDERS=Новости,Работа
# TG_STATE_FILE=./data/tg_state.json
# TG_BACKFILL=20       # последних сообщений из чата при первом опросе
# TG_MIN_LEN=80
# POLL_INTERVAL_S=60   # для Telegram реже, чем 10s, иначе flood wait
