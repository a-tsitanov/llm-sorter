# OpenAI-совместимый сервер моделей (vLLM, LM Studio ...)
LLM_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# гейт и модель discover на отдельных серверах (пусто - LLM_URL)
LLM_GUARD_URL=
LLM_GUARD_API_KEY=
LLM_TEXT_URL=
LLM_TEXT_API_KEY=
MODEL_DECIDE=lfm2
MODEL_GUARD=qwen3-4b
MODEL_TEXT=qwen3-4b
MODEL_EMBED=bge-m3

# дерево тем, журнал изменений, позиция дообучения
SQLITE_PATH=./data/sorter.db

RABBIT_URL=amqp://guest:guest@localhost:5672/
INBOX_QUEUE=llm-sorter.inbox
CLASSIFIED_EXCHANGE=llm-sorter.classified
CLASSIFIED_ARCHIVE=llm-sorter.classified.all
OTHER_STREAM=llm-sorter.other
# ретеншн stream other (формат x-max-age: 30D, 12h); менять у живого stream нельзя
OTHER_MAX_AGE=30D
OTHER_MAX_BYTES=10737418240

PROCESS_CONCURRENCY=16
TREE_REFRESH_S=1
LEARNER_CHECK_S=30
OTHER_REFRESH_S=86400
# 0 - без метрик (нужно для второго обработчика на той же машине)
METRICS_PORT=9100
LEARNER_METRICS_PORT=9101

# фидер каталога (feed dir)
SOURCE_DIR=./data/inbox
POLL_INTERVAL_S=10

# фидер Telegram (feed tg); список папок: llm-sorter tg-folders
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION=          # Telethon StringSession
# TG_FOLDERS=Новости,Работа
# TG_STATE_FILE=./data/tg_state.json
# TG_BACKFILL=20       # последних сообщений из чата при первом опросе
# TG_MIN_LEN=80
# для Telegram опрос реже, чем 10 с, иначе flood wait: POLL_INTERVAL_S=60

# хостовые порты RabbitMQ для docker compose (если 5672/15672 заняты); тогда поправить RABBIT_URL
# RABBIT_PORT=5673
# RABBIT_MGMT_PORT=15673
